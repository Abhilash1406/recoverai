# =============================================================================
# RecoverAI — Environment Variable Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file. Only this .env.example is tracked by Git.
# =============================================================================

# --- Application ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# --- Database (Phase 2+) ---
# MongoDB connection string — do not populate in Phase 1
MONGODB_URI=

# --- Razorpay (Phase 3+) ---
# Test-mode credentials only — never use production credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- AI (Phase 4+) ---
# Gemini API key — never expose to frontend
GEMINI_API_KEY=

# --- Security (Phase 2+) ---
JWT_SECRET=
JWT_EXPIRES_IN=7d
