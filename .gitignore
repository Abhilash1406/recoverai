# =============================================================================
# RecoverAI — .gitignore
# =============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
out/
*.tsbuildinfo

# Environment variables — NEVER commit .env files
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor directories
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc
.Python
*.egg
*.egg-info/
dist/
develop-eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.whl
.installed.cfg
.venv/
venv/
ENV/
env/
.python-version

# ML artifacts
ml/data/raw/*
ml/data/processed/*
ml/data/synthetic/*
ml/models/*.pkl
ml/models/*.joblib
ml/models/*.h5
ml/models/*.pt
ml/models/*.pth
!ml/data/raw/.gitkeep
!ml/data/processed/.gitkeep
!ml/data/synthetic/.gitkeep
!ml/models/.gitkeep

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb_checkpoints

# Docker
.docker/

# Coverage
coverage/
.nyc_output/
htmlcov/
.coverage
.pytest_cache/

# Misc
*.pid
*.seed
*.pid.lock
